pkgname=epitech-vim
pkgver=20261014
pkgrel=0
pkgdesc="Epitech vim configuration"
url="https://github.com/Epitech/vim-epitech"
arch="noarch"
license="MIT"
depends="vim"
source="$pkgname-$pkgver.tar.gz::https://raw.githubusercontent.com/TheodoreGozard/epiclang-alpine-package/refs/heads/main/$pkgname/$pkgname-$pkgver.tar.gz"

package() {
    mkdir -p "$pkgdir/usr/share/vim/vimfiles/plugin"
    install -D -m 644 "$srcdir/epitech.vim" "$pkgdir/usr/share/vim/vimfiles/plugin/epitech.vim"
}
